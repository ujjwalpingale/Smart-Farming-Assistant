# Smart Farming Assistant - Environment Configuration
# Copy this file to .env and update with your actual values

# Django Settings
# Generate a new SECRET_KEY using: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=your-super-secret-key-change-this-in-production

# Set to 'true' only in development environments
DEBUG=False

# Comma-separated list of allowed host domains
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# MySQL Database Configuration
MYSQL_DATABASE=smart_farming_db
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# Weather & AI API Keys
WEATHER_API_KEY=your_openweather_api_key
GEMINI_API_KEY=your_gemini_api_key

# Security Settings (recommended for production)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# HSTS settings (HTTP Strict Transport Security) - for production only
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
DJANGO_LOG_LEVEL=INFO
